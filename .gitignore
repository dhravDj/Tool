# Git Ignore for DocuMind AI

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Testing & Quality
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Storage & Temporary Files (Keep folder structure, ignore contents)
storage/uploads/*
!storage/uploads/.gitkeep
storage/temporary/*
!storage/temporary/.gitkeep
storage/processed/*
!storage/processed/.gitkeep
storage/assets/*
!storage/assets/.gitkeep
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
backend/storage/temporary/*
!backend/storage/temporary/.gitkeep
backend/storage/processed/*
!backend/storage/processed/.gitkeep
backend/storage/assets/*
!backend/storage/assets/.gitkeep

# SQLite database (if used for local testing)
*.db
*.sqlite3

# Node / Frontend
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
frontend/dist/
frontend/.dist/
.vite/

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
