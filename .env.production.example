# ==============================================================================
# DocuMind AI — Production Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to .env.production
# 2. Generate strong secrets:
#    - SECRET_KEY: `openssl rand -hex 32`
#    - POSTGRES_PASSWORD: `openssl rand -base64 24`
#    - REDIS_PASSWORD: `openssl rand -base64 24`
# 3. Ensure DEBUG=false and APP_ENV=production
# 4. Restrict BACKEND_CORS_ORIGINS to exact production domains
# ==============================================================================

# 1. CORE APPLICATION RUNTIME
APP_NAME="DocuMind AI"
APP_ENV=production
APP_VERSION=0.14.0
DEBUG=false
API_V1_STR=/api/v1
SECRET_KEY=REPLACE_WITH_OPENSSL_HEX_32_GENERATED_SECRET_KEY

# Server Host & Bind
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Production Allowed Domains (Strict JSON array format)
BACKEND_CORS_ORIGINS=["https://documind.yourdomain.com"]

# 2. PRODUCTION DATABASE (PostgreSQL 16)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=documind_prod
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=documind_prod_db
DATABASE_URL=postgresql+asyncpg://documind_prod:REPLACE_WITH_STRONG_POSTGRES_PASSWORD@postgres:5432/documind_prod_db
SYNC_DATABASE_URL=postgresql+psycopg2://documind_prod:REPLACE_WITH_STRONG_POSTGRES_PASSWORD@postgres:5432/documind_prod_db

# Connection Pool Tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=1800

# 3. CACHE & DISTRIBUTED QUEUE (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_DB=0
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/0

# 4. STORAGE CONFIGURATION
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/app/storage
MAX_UPLOAD_SIZE_BYTES=524288000  # 500 MB production limit

# Optional S3 / Object Store Integration
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=documind-prod-storage
S3_REGION=us-east-1

# 5. HARDWARE GOVERNOR & CONCURRENCY
HARDWARE_PROFILE=production
MAX_PARALLEL_CPU_WORKERS=4
GPU_MAX_CONCURRENT_INFERENCE=1
TASK_WORKER_HEARTBEAT_SECONDS=15
TASK_STALE_TIMEOUT_SECONDS=90

# 6. AI INTELLIGENCE & PRIVACY BOUNDARIES
AI_MODE=local
LOCAL_MODEL_PROVIDER=ollama
LOCAL_INFERENCE_DEVICE=cpu
OLLAMA_BASE_URL=http://ollama:11434

# Cloud AI Opt-In (Explicit user consent required)
CLOUD_PROCESSING_ENABLED=false
CLOUD_MODEL_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 7. LOGGING & OBSERVABILITY
LOG_LEVEL=INFO
LOG_FORMAT=json
REQUEST_ID_HEADER=X-Request-ID
