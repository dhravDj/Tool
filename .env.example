# DocuMind AI — Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# ==============================================================================
# 1. APPLICATION SETTINGS
# ==============================================================================
APP_NAME="DocuMind AI"
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars-documind-ai

# Server Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# CORS (Comma-separated list of origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:8000"]

# ==============================================================================
# 2. DATABASE SETTINGS (PostgreSQL)
# ==============================================================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind_secure_password
POSTGRES_DB=documind_db
# Asynchronous connection string (used by backend)
DATABASE_URL=postgresql+asyncpg://documind:documind_secure_password@localhost:5432/documind_db
# Synchronous connection string (used by Alembic)
SYNC_DATABASE_URL=postgresql+psycopg2://documind:documind_secure_password@localhost:5432/documind_db

# ==============================================================================
# 3. CACHE & QUEUE SETTINGS (Redis)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# 4. STORAGE CONFIGURATION
# ==============================================================================
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage
MAX_UPLOAD_SIZE_BYTES=104857600  # 100 MB limit

# S3 / MinIO Settings (ready for cloud object storage)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=documind-storage
S3_REGION=us-east-1

# ==============================================================================
# 5. AI ENGINE CONFIGURATION (LOCAL-FIRST & SOVEREIGN)
# ==============================================================================
# Options: local | cloud | hybrid
AI_MODE=local
# Local AI Provider (e.g. ollama, vllm, mock)
LOCAL_MODEL_PROVIDER=ollama
LOCAL_INFERENCE_DEVICE=cpu
OLLAMA_BASE_URL=http://localhost:11434

# Cloud AI Provider (strictly disabled by default)
CLOUD_PROCESSING_ENABLED=false
CLOUD_MODEL_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
